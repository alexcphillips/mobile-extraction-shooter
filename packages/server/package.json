{
  "name": "@mes/server",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "node ../../scripts/bundle-content.mjs",
    "predev": "npm run content && node -e \"require('fs').mkdirSync('../client/dist', { recursive: true })\"",
    "dev": "wrangler dev --ip 0.0.0.0 --var ADMIN:1",
    "predeploy": "npm run content && wrangler d1 migrations apply mes --remote",
    "deploy": "wrangler deploy",
    "pretypecheck": "npm run content",
    "typecheck": "tsc -p .",
    "db:migrate": "wrangler d1 migrations apply mes --local"
  },
  "dependencies": {
    "@mes/shared": "*",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "wrangler": "^4.152.0"
  }
}
