{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mobile-extraction-shooter",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // One Worker serves the built client and the API, so they share an origin
  // (no CORS, and session cookies just work). Only /api/* reaches the Worker code.
  "assets": {
    "directory": "../client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Accounts, sessions, profiles and raids (session 12). The schema is migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mes",
      "database_id": "1e21429f-6035-488c-b29a-1b5ee746c1ff",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true },
}
